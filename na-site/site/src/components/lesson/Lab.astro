---
// Exact commands on Linux, what to look at, and the expected result. The
// source header says where the code comes from (docs/PEDAGOGY.md rule 17).
// A line under the clone commands says what git clone and cd do, for a reader
// new to git. The default slot says what the program does and what the reader
// should see, then holds a Terminal for each command.
import Terminal from '../diagram/Terminal.astro';

const REPO = 'https://github.com/jitendraag/cn-at-scaler';

export interface Props {
  title: string;
  /**
   * The folder of the lab in the instructor repo, such as "lesson1". Every new
   * lab gives it. The pilots have none until their rebuild, so their header
   * shows the clone command with no cd.
   */
  folder?: string;
}
const { title, folder } = Astro.props;
---

<section class="lab" aria-label={`Lab: ${title}`}>
  <p class="label">Lab: run it yourself on Linux</p>
  <p class="title">{title}</p>
  <div class="source">
    <p>The code comes from the public course repo of the instructor, <a href={REPO}>github.com/jitendraag/cn-at-scaler</a>.</p>
    <Terminal
      title={folder ? `Copy the repo, then go to the folder ${folder}` : 'Copy the repo'}
      runs={[{ cmd: `git clone ${REPO}.git` }, ...(folder ? [{ cmd: `cd cn-at-scaler/${folder}` }] : [])]}
    />
    <p><code>git clone</code> downloads a copy of the instructor repo{folder ? <>, and <code>cd</code> moves into the lab folder inside it.</> : '.'}</p>
  </div>
  <slot />
</section>

<style>
  .lab {
    margin: var(--space-6) 0;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 4px solid var(--correct);
    border-radius: var(--radius);
  }
  .label {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--correct);
  }
  .title {
    margin-top: var(--space-1);
    font-weight: 600;
  }
  .source {
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rule);
  }
  .source p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
