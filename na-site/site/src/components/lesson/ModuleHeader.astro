---
import type { CollectionEntry } from 'astro:content';
import { href, sessionHref } from '../../lib/url';
import { DIGEST_LABEL, DIGEST_TIME, threadTitle } from '../shell/lessons';
import ModuleLink from './ModuleLink.astro';

type Module = CollectionEntry<'modules'>['data'];

// The lesson opening that the module page gives: the title, then one short
// block with the big idea, the lessons before this one and the threads. A new
// reader does not know the word "thread", so the line says what a thread is.
// Titles only, never an ID. The outline and the progress live in the sidebar.
export interface Props extends Pick<
  Module,
  'session' | 'title' | 'minutes' | 'bigIdea' | 'status' | 'prereqs' | 'threads'
> {
  /** A page with no kind is a lesson. */
  kind?: Module['kind'];
}
const { session, kind, title, minutes, bigIdea, status, prereqs, threads } = Astro.props;
// ", " between items, and " and " before the last one
const sep = (i: number, length: number) => (i === 0 ? '' : i === length - 1 ? ' and ' : ', ');
---

<header class="opening">
  <p class="eyebrow">
    <a href={sessionHref(session)}>Session {session}</a> · {minutes ? `${minutes} min` : DIGEST_TIME}{
      kind === 'digest' && <span class="tag">{DIGEST_LABEL}</span>
    }{status === 'draft' && <span class="tag">Draft</span>}
  </p>
  <h1>{title}</h1>
  <div class="big-idea">
    <p><strong>The big idea.</strong> {bigIdea}</p>
    {
      (prereqs.length > 0 || threads.length > 0) && (
        <p class="links">
          {prereqs.length > 0 && (
            <>
              This lesson builds on{' '}
              {prereqs.map((id, i) => (
                <>
                  {sep(i, prereqs.length)}
                  <ModuleLink id={id} />
                </>
              ))}
              .
            </>
          )}
          {prereqs.length > 0 && threads.length > 0 && ' '}
          {threads.length > 0 && (
            <>
              This idea comes back in:{' '}
              {threads.map((id, i) => (
                <>
                  {sep(i, threads.length)}
                  <a href={href(`threads/${id}/`)}>{threadTitle(id)}</a>
                </>
              ))}
              . {threads.length === 1 ? 'The link opens a thread' : 'Each link opens a thread'}: one idea that runs
              through several lessons.
            </>
          )}
        </p>
      )
    }
  </div>
</header>

<style>
  .opening {
    margin-bottom: var(--space-8);
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-variant: small-caps;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }
  /* A tag never breaks inside its border, also when the line wraps. */
  .tag {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 0 var(--space-2);
    white-space: nowrap;
    border: 1px solid currentColor;
    border-radius: var(--radius-l);
  }
  .big-idea {
    padding: var(--space-3) var(--space-4);
    background: var(--accent-soft);
    border: var(--bw) solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-m);
  }
  .big-idea p {
    margin: 0;
  }
  .big-idea strong {
    color: var(--accent-2);
  }
  .big-idea .links {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  /* A title in italics, so a colon or a comma in it does not break the sentence */
  .links :global(a),
  .links :global(.planned) {
    font-style: italic;
  }
</style>
