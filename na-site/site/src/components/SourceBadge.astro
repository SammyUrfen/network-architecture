---
import type { CollectionEntry } from 'astro:content';

interface Props {
  status: CollectionEntry<'sessions'>['data']['sourceStatus'];
}
const { status } = Astro.props;
// The word carries the meaning. The mark and the color only repeat it.
const text = { complete: 'Sources complete', partial: 'Sources partial', missing: 'No sources yet' }[status];
const mark = { complete: '●', partial: '◐', missing: '○' }[status];
---

<span class:list={['badge', status]}><span aria-hidden="true">{mark}</span> {text}</span>

<style>
  .badge {
    display: inline-flex;
    gap: var(--space-1);
    padding: 0 var(--space-2);
    font-size: var(--text-sm);
    border: 1px solid currentColor;
    border-radius: 999px;
    white-space: nowrap;
  }
  .complete {
    color: var(--correct);
    background: var(--correct-bg);
  }
  .partial {
    color: var(--key);
    background: var(--key-bg);
  }
  .missing {
    color: var(--text-muted);
    background: var(--surface-2);
  }
</style>
