---
// Finds the quiz item at build time and passes it to the island.
import Island from './Check.tsx';
import { itemById, misconceptionsOf } from './items';

export interface Props {
  /** A quiz item ID, such as s01-m08-q01. */
  id: string;
}

const item = await itemById(Astro.props.id);
---

<Island client:load item={item} misconceptions={misconceptionsOf([item])} />
