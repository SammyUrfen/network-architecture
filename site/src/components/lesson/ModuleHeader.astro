---
import type { CollectionEntry } from 'astro:content';
import { href, sessionHref } from '../../lib/url';
import { threadTitle } from '../shell/lessons';
import ModuleLink from './ModuleLink.astro';

type Module = CollectionEntry<'modules'>['data'];

// The lesson opening that the module page gives: the title, then one short
// block with the big idea and one sentence that names the lessons before
// this one and the threads. Titles only, never an ID. The outline and the
// progress live in the sidebar.
export interface Props extends Pick<
  Module,
  'session' | 'title' | 'minutes' | 'bigIdea' | 'status' | 'prereqs' | 'threads'
> {}
const { session, title, minutes, bigIdea, status, prereqs, threads } = Astro.props;
// ", " between items, and " and " before the last one
const sep = (i: number, length: number) => (i === 0 ? '' : i === length - 1 ? ' and ' : ', ');
---

<header class="opening">
  <p class="eyebrow">
    <a href={sessionHref(session)}>Session {session}</a> · {minutes} min{
      status === 'draft' && <span class="draft">Draft</span>
    }
  </p>
  <h1>{title}</h1>
  <div class="big-idea">
    <p><strong>The big idea.</strong> {bigIdea}</p>
    {
      (prereqs.length > 0 || threads.length > 0) && (
        <p class="links">
          {prereqs.length > 0 && (
            <>
              This lesson builds on{' '}
              {prereqs.map((id, i) => (
                <>
                  {sep(i, prereqs.length)}
                  <ModuleLink id={id} />
                </>
              ))}
            </>
          )}
          {prereqs.length > 0 && threads.length > 0 && ', and its ideas come back in '}
          {prereqs.length === 0 && 'The ideas of this lesson come back in '}
          {threads.length > 0 && (
            <>
              {threads.length === 1 ? 'the thread ' : 'the threads '}
              {threads.map((id, i) => (
                <>
                  {sep(i, threads.length)}
                  <a href={href(`threads/${id}/`)}>{threadTitle(id)}</a>
                </>
              ))}
            </>
          )}
          .
        </p>
      )
    }
  </div>
</header>

<style>
  .opening {
    margin-bottom: var(--space-8);
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-variant: small-caps;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }
  .draft {
    margin-left: var(--space-2);
    padding: 0 var(--space-2);
    border: 1px solid currentColor;
    border-radius: var(--radius-l);
  }
  .big-idea {
    padding: var(--space-3) var(--space-4);
    background: var(--accent-soft);
    border: var(--bw) solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-m);
  }
  .big-idea p {
    margin: 0;
  }
  .big-idea strong {
    color: var(--accent-2);
  }
  .big-idea .links {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  /* A title in italics, so a colon or a comma in it does not break the sentence */
  .links :global(a),
  .links :global(.planned) {
    font-style: italic;
  }
</style>
