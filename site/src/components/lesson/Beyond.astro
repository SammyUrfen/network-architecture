---
// Content that the instructor did not teach (PEDAGOGY rule 10). The badge
// word carries the meaning, and the reference lets the learner check it.
export interface Props {
  /** The reference, such as "RFC 9110 §15.5.6". */
  source: string;
  /** A link to the reference, when it has a public page. */
  url?: string;
}
const { source, url } = Astro.props;
---

<aside class="beyond" aria-label="Beyond the slides">
  <p class="badge"><span aria-hidden="true">+</span> Beyond the slides</p>
  <slot />
  <p class="ref">Reference: {url ? <a href={url}>{source}</a> : source}</p>
</aside>

<style>
  .beyond {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-2);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  .badge {
    display: inline-block;
    margin: 0 0 var(--space-2);
    padding: 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    border: 1px solid currentColor;
    border-radius: 999px;
  }
  .ref {
    margin-bottom: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
