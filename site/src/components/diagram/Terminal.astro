---
// A real command and the output it printed. Measured output keeps its
// conditions in the title (CLAUDE.md content rule 3).
export interface Props {
  /** What the run shows and where it ran, such as "Server side, loopback". */
  title?: string;
  /** Each command, with the output it printed. Leave out output that the lesson does not use. */
  runs: { cmd: string; out?: string }[];
}
const { title, runs } = Astro.props;
---

<figure class="terminal">
  {title && <figcaption>{title}</figcaption>}
  <pre
    tabindex="0"><code>{runs.map(({ cmd, out }) => (<><span class="cmd"><span class="prompt" aria-hidden="true">$ </span>{cmd.split(/(\s+)/).map((part, i) => (i % 2 ? part : <span class="word">{part}</span>))}</span>{out && <span class="out">{out}</span>}</>))}</code></pre>
</figure>

<style>
  .terminal {
    margin: var(--space-4) 0;
  }
  figcaption {
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  /* A long output line keeps its columns and scrolls. The scroll bar stays
     visible, so the reader knows that more text is there. */
  pre {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  /* Chromium and Safari draw a styled scroll bar at all times, also where the
     system uses overlay scroll bars that hide. Chromium ignores these rules
     when scrollbar-color is set, so only Firefox gets scrollbar-color. */
  @supports selector(::-webkit-scrollbar) {
    pre::-webkit-scrollbar {
      height: 0.625rem;
    }
    pre::-webkit-scrollbar-track {
      background: var(--surface-2);
      border-radius: 0 0 var(--radius) var(--radius);
    }
    pre::-webkit-scrollbar-thumb {
      background: var(--text-muted);
      border-radius: 999px;
    }
  }
  @supports not selector(::-webkit-scrollbar) {
    pre {
      scrollbar-color: var(--text-muted) var(--surface-2);
    }
  }
  code {
    padding: 0;
    background: none;
  }
  .cmd,
  .out {
    display: block;
  }
  /* A long command wraps at a space only, so a break never looks like a
     space inside a word such as "site-a.local". A word longer than the line
     scrolls. The lines after the first start under the command, not under "$". */
  .cmd {
    padding-left: 2ch;
    text-indent: -2ch;
    white-space: pre-wrap;
  }
  .word {
    white-space: nowrap;
  }
  /* A copy of the command leaves out the prompt. */
  .prompt {
    user-select: none;
  }
  .prompt,
  .out {
    color: var(--text-muted);
  }
  /* The same ink pair as a button, so selected text reads in both themes. */
  .cmd::selection,
  .word::selection,
  .out::selection {
    color: var(--bg);
    background: var(--interactive);
  }
</style>
