---
import { getCollection } from 'astro:content';
import ModuleLink from '../../components/lesson/ModuleLink.astro';
import { plannedLessons, sessionLessons } from '../../components/shell/lessons';
import SourceBadge from '../../components/SourceBadge.astro';
import Base from '../../layouts/Base.astro';
import { day } from '../../lib/url';

export async function getStaticPaths() {
  const sessions = await getCollection('sessions');
  return sessions.map((entry) => ({ params: { session: entry.id }, props: { entry } }));
}

const { data: s } = Astro.props.entry;
const pages = (await getCollection('modules', (m) => m.data.session === s.number)).sort((a, b) => a.data.order - b.data.order);
// The planned lessons in curriculum order, then any page with no heading.
// Sessions 6 to 8 have no curriculum file yet.
const lessons = sessionLessons(
  plannedLessons(s.number),
  pages.map((m) => ({ id: m.id, title: m.data.title })),
);
const meta = new Map(pages.map((m) => [m.id, m.data]));
---

<Base title={`Session ${s.number}: ${s.title}`}>
  <p class="eyebrow">Session {s.number}</p>
  <h1>{s.title}</h1>
  {s.subtitle && <p class="subtitle">“{s.subtitle}”</p>}
  <p class="meta">
    {s.sourceStatus === 'missing' ? 'Planned for' : 'Taught'}
    {s.dateApprox ? ' about ' : ' '}
    {day(s.date)}
    <SourceBadge status={s.sourceStatus} />
  </p>

  <h2>Lessons</h2>
  {
    lessons.length === 0 ? (
      <p class="empty">No lessons are planned yet. The plan comes after the class.</p>
    ) : (
      <ol class="modules">
        {lessons.map(({ id }) => {
          const m = meta.get(id);
          return (
            <li>
              <ModuleLink id={id} />
              {m && (
                <span class="minutes">
                  {m.minutes} min{m.status === 'draft' ? ' · draft' : ''}
                </span>
              )}
            </li>
          );
        })}
      </ol>
    )
  }
</Base>

<style>
  .eyebrow,
  .meta,
  .minutes,
  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .eyebrow {
    margin-bottom: 0;
  }
  .subtitle {
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .modules li {
    margin-bottom: var(--space-2);
  }
  .minutes {
    margin-left: var(--space-2);
    white-space: nowrap;
  }
</style>
