---
import { getCollection } from 'astro:content';
import ModuleLink from '../../components/lesson/ModuleLink.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import Base from '../../layouts/Base.astro';
import { day, href } from '../../lib/url';

export async function getStaticPaths() {
  const sessions = await getCollection('sessions');
  return sessions.map((entry) => ({ params: { session: entry.id }, props: { entry } }));
}

const { data: s } = Astro.props.entry;
const pages = new Map((await getCollection('modules', (m) => m.data.session === s.number)).map((m) => [m.id, m.data]));

// The planned modules, in the order of their headings in the curriculum file,
// with the line pattern of scripts/verify-content.mjs. Sessions 6 to 8 have no file yet.
const curriculum = import.meta.glob<string>('../../../../docs/curriculum/session-*.md', { query: '?raw', import: 'default', eager: true });
const text = curriculum[`../../../../docs/curriculum/session-${String(s.number).padStart(2, '0')}.md`] ?? '';
const planned = [...text.matchAll(/^### (s\d\d-m\d\d-[a-z0-9-]+)$/gm)].map((match) => match[1]);
// A page with no heading still shows, after the planned modules.
const modules = [...planned, ...[...pages.keys()].filter((id) => !planned.includes(id))];
---

<Base title={`Session ${s.number}: ${s.title}`}>
  <p class="crumb"><a href={href()}>Map</a></p>
  <p class="eyebrow">Session {s.number}</p>
  <h1>{s.title}</h1>
  {s.subtitle && <p class="subtitle">“{s.subtitle}”</p>}
  <p class="meta">
    {s.sourceStatus === 'missing' ? 'Planned for' : 'Taught'}
    {s.dateApprox ? ' about ' : ' '}
    {day(s.date)}
    <SourceBadge status={s.sourceStatus} />
  </p>

  <h2>Lessons</h2>
  {
    modules.length === 0 ? (
      <p class="empty">No lessons are planned yet. The plan comes after the class.</p>
    ) : (
      <ol class="modules">
        {modules.map((id) => {
          const m = pages.get(id);
          return (
            <li>
              <ModuleLink id={id} />
              {m && (
                <span class="minutes">
                  {m.minutes} min{m.status === 'draft' ? ' · draft' : ''}
                </span>
              )}
            </li>
          );
        })}
      </ol>
    )
  }
</Base>

<style>
  .crumb,
  .eyebrow,
  .meta,
  .minutes,
  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .eyebrow {
    margin-bottom: 0;
  }
  .subtitle {
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .modules li {
    margin-bottom: var(--space-2);
  }
  .minutes {
    margin-left: var(--space-2);
    white-space: nowrap;
  }
</style>
