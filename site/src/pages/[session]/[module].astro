---
import { getCollection, render } from 'astro:content';
import ModuleHeader from '../../components/lesson/ModuleHeader.astro';
import ModuleProgress from '../../components/lesson/ModuleProgress.tsx';
import { segmentTitles } from '../../components/lesson/segments';
import Base from '../../layouts/Base.astro';
import { moduleParams, sessionHref } from '../../lib/url';

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  return modules.map((entry) => ({ params: moduleParams(entry.id), props: { entry } }));
}

const { entry } = Astro.props;
const m = entry.data;
const { Content } = await render(entry);
---

<Base title={m.title}>
  <p class="crumb"><a href={sessionHref(m.session)}>Session {m.session}</a></p>
  <ModuleHeader {...m} segments={segmentTitles(entry.body ?? '')}>
    <ModuleProgress slot="progress" client:only="preact" id={m.id} />
  </ModuleHeader>
  <Content />
</Base>

<style>
  .crumb {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
